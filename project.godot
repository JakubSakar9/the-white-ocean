; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The White Ocean"
run/main_scene="res://ui/splash_screen/splash_screen_manager.tscn"
config/features=PackedStringArray("4.3", "C#", "GL Compatibility")
boot_splash/bg_color=Color(1, 1, 1, 1)
boot_splash/show_image=false
config/icon="res://assets/other/icon256.png"

[autoload]

SaveManager="*res://common/autoload/save_manager.gd"
SceneSwitcher="*res://common/autoload/scene_switcher.gd"
TransitionScreen="*res://ui/transition_screen/transition_screen.tscn"
GlobalSettings="*res://common/autoload/global_settings.gd"

[display]

window/size/mode=3
window/size/initial_position_type=2

[dotnet]

project/assembly_name="White Sea"

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://common/": "purple",
"res://entities/": "red",
"res://levels/": "blue",
"res://materials/": "orange",
"res://ui/": "green"
}

[filesystem]

import/fbx/enabled=false

